#!/bin/bash

# auto swap canton

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# config
wallet="f39732...b438"
contract="33ef96...3289e1d"

min_balance=43
check_time=60

# cek balance
check_balance() {
    echo -e "${BLUE}[$(date)] checking balance...${NC}"

    balance=$(curl -s "https://wallet.cantor8.tech/api/balance?address=$wallet" | jq -r '.balance')

    echo "balance: $balance CANTON"

    if (( $(echo "$balance >= $min_balance" | bc -l) )); then
        return 0
    else
        return 1
    fi
}

# swap
do_swap() {
    echo -e "${YELLOW}starting swap...${NC}"

    amount="43.00"
    memo="ord_ajr7j8j48nq8zn1v"

    response=$(curl -s -X POST "https://wallet.cantor8.tech/api/swap" \
        -H "Content-Type: application/json" \
        -d '{
            "from":"'$wallet'",
            "to":"'$contract'",
            "amount":"'$amount'",
            "token":"CANTON",
            "memo":"'$memo'"
        }')

    if [[ $? -eq 0 ]]; then
        echo -e "${GREEN}swap success${NC}"
        echo "$response"
    else
        echo -e "${RED}swap failed${NC}"
    fi
}

# cek status tx
check_tx() {
    tx=$(curl -s "https://wallet.cantor8.tech/api/transaction/status?address=$wallet" | jq -r '.status')

    echo "tx status: $tx"
}

# install package
install_pkg() {
    pkg update -y
    pkg install curl jq bc -y
}

# main
run() {
    echo -e "${GREEN}auto swap started${NC}"
    echo "wallet : $wallet"
    echo "min balance : $min_balance"
    echo "check every : ${check_time}s"
    echo ""

    while true; do
        if check_balance; then
            echo -e "${GREEN}balance ready, swapping...${NC}"

            do_swap
            check_tx

            echo "wait 5 min..."
            sleep 300
        else
            echo -e "${YELLOW}not enough balance${NC}"
        fi

        sleep $check_time
    done
}

if [[ "$1" == "install" ]]; then
    install_pkg
else
    trap 'echo -e "\nstop script"; exit' INT
    run
fi