{ @tailwind base;
@tailwind components;
@tailwind utilities;

body {
  margin: 0;
  background: #050816;
  color: white;
  font-family: Arial, sans-serif;
}

.glow {
  box-shadow: 0 0 30px rgba(59,130,246,0.5);
}

.gradient-text {
  background: linear-gradient(to right, #3b82f6, #06b6d4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}